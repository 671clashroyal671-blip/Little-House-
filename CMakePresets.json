{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Little Hous Engine - default",
      "description": "Configure the desktop editor using Ninja and pinned FetchContent dependencies.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LHE_BUILD_EDITOR": "ON",
        "LHE_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Little Hous Engine - release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" }
  ]
}
